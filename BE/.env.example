# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Use a long random string in production (min 32 chars)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL (no trailing slash)
CLIENT_URL=https://your-frontend-domain.com

# ─── Upload ──────────────────────────────────────────────────────────────────
AVATAR_MAX_SIZE=2097152
CV_MAX_SIZE=5242880

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
